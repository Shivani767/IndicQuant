[
  {
    "id": "hi-book-bom-del",
    "query": "मुंबई से दिल्ली के लिए 2 टिकट बुक करो",
    "language": "hi",
    "script": [
      {"tool": "book_ticket", "args": {"origin": "मुंबई", "destination": "दिल्ली", "passengers": 2}},
      {"reply": "2 टिकट बुक हो गई PNR BOMDEL02"}
    ],
    "expect": {
      "intent": "book",
      "bind_origin": "BOM",
      "bind_dest": "DEL",
      "reply_contains": ["BOMDEL02"],
      "grounded": true
    }
  },
  {
    "id": "hi_en-book-maa",
    "query": "chennai se mumbai ke liye 1 ticket book karo",
    "language": "hi_en",
    "script": [
      {"tool": "book_ticket", "args": {"origin": "chennai", "destination": "mumbai", "passengers": 1}},
      {"reply": "booked MAA->BOM PNR MAABOM01"}
    ],
    "expect": {
      "intent": "book",
      "bind_origin": "MAA",
      "bind_dest": "BOM",
      "reply_contains": ["MAABOM01"],
      "grounded": true
    }
  },
