  {
    "id": "hi-gst-honest",
    "query": "500 रुपये पर 18 प्रतिशत GST कितना?",
    "language": "hi",
    "script": [
      {"tool": "inr_gst", "args": {"amount": "500", "rate": "18"}},
      {"reply": "कुल 590 रुपये"}
    ],
    "expect": {
      "intent": "gst",
      "reply_contains": ["590"],
      "grounded": true
    }
  },
  {
    "id": "hi-gst-hallucination",
    "query": "500 पर 18 प्रतिशत कर",
    "language": "hi",
    "script": [
      {"tool": "calculator", "args": {"expr": "500 + 500*18/100"}},
      {"reply": "कुल 999 रुपये है।"},
      {"reply": "कुल 590 रुपये है।"}
    ],
    "expect": {
      "hallucination_caught": true,
      "reply_contains": ["590"],
      "reply_excludes": ["999"],
      "grounded": true
    }
  },
  {
